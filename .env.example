# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp webhook (Make.com / Evolution API / Zapier) - o app faz POST ao criar gastos/assinaturas
NEXT_PUBLIC_WHATSAPP_WEBHOOK_URL=https://hooks.example.com/notify

# App
NEXT_PUBLIC_APP_NAME=LoteadoraMVP

# (opcional) segredo usado para assinar webhooks enviados ao seu endpoint WhatsApp/Make
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
